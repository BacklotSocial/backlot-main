rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['authorType', 'authorId', 'authorName', 'text', 'parentId', 'createdAt']
           )
        && request.resource.data.authorType in ['user', 'character']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /characters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // One doc per signed-in user: identity (name/handle), used to resolve
    // @mentions and to render profile pages. Not a general-purpose profile
    // system — just enough to mirror old Twitter's name vs @handle split.
    match /users/{uid} {
      allow read: if true;

      // First-time creation, done by the app right after sign-in.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['displayName', 'handle', 'createdAt', 'lastNameChangeAt'])
        && isValidHandle(request.resource.data.handle)
        && request.resource.data.lastNameChangeAt == request.time;

      allow update: if request.auth != null && request.auth.uid == uid && isValidUserUpdate();

      allow delete: if false;
    }

    // "X replied to you" / "X mentioned you". Written by whoever performed
    // the action, addressed to the recipient — so create isn't restricted
    // to auth.uid == toUserId.
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.toUserId;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['toUserId', 'type', 'fromName', 'snippet', 'sourcePostId', 'createdAt', 'read']
           )
        && request.resource.data.type in ['reply', 'mention']
        && request.resource.data.toUserId is string
        && request.resource.data.snippet.size() <= 200
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      // Recipient can only flip `read` — nothing else.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    function isValidHandle(handle) {
      return handle is string && handle.size() >= 2 && handle.size() <= 20
        && handle.matches('^[a-z0-9_]+$');
    }

    // Photo can be refreshed freely on every sign-in. Changing displayName
    // or handle is only allowed once every 7 days, timestamped by the write
    // itself (lastNameChangeAt must equal request.time on an identity change).
    function isValidUserUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let identityChanged = changedKeys.hasAny(['displayName', 'handle']);
      let cooldownOk = !('lastNameChangeAt' in resource.data)
        || resource.data.lastNameChangeAt == null
        || request.time.toMillis() > resource.data.lastNameChangeAt.toMillis() + 604800000;

      return changedKeys.hasOnly(['displayName', 'handle', 'photoURL', 'createdAt', 'lastNameChangeAt'])
        && isValidHandle(request.resource.data.handle)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && (!identityChanged || (request.resource.data.lastNameChangeAt == request.time && cooldownOk));
    }
  }
}
